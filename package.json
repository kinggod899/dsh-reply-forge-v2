{
  "name": "@local/dsh-reply-forge-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "DSH 桌面端插件 v2：伪造回复写入会话落盘记录，被大模型采信，会话可继续对话",
  "main": "./.dsh-plugin/index.mjs",
  "exports": {
    ".": "./.dsh-plugin/index.mjs",
    "./client": "./.dsh-plugin/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "license": "MIT"
}
